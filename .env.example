GEMINI_API_KEY=
# Un modèle par fonction (tous optionnels — voir README.md)
# GEMINI_MODEL_CHAT=gemini-3.5-flash-lite
# GEMINI_MODEL_VISION=gemini-3.5-flash-lite
# GEMINI_MODEL_VOICE=gemini-3.5-flash-lite
# GEMINI_MODEL_CHEF=gemini-3.5-flash
# GEMINI_MODEL_IMAGE=gemini-nano-banana-2.1
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# NUTRIX_ACCESS_CODE=
# AI_DAILY_LIMIT=40
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# CORS_ALLOWED_ORIGINS=https://your-domain.example

# IA de secours gratuite (texte : chat + Chef) quand Gemini est saturé — clé sur console.groq.com
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# Images de secours gratuites (dash.cloudflare.com → Workers AI → API token)
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
